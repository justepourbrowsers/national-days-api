{
  "info": {
    "name": "National Days API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Regression tests. Set baseUrl to http://127.0.0.1:5000 (local) or your Render URL."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('195 countries', () => pm.expect(pm.response.json().countries).to.eql(195));"
            ]
          }
        }
      ]
    },
    {
      "name": "Sort by country (A-Z)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/national-days?sort=country",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "national-days"
          ],
          "query": [
            {
              "key": "sort",
              "value": "country"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const names = pm.response.json().map(d => d.country);",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Sorted alphabetically', () => pm.expect(names).to.eql([...names].sort((a, b) => a.localeCompare(b, 'en'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "Sort by first_celebration (desc)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/national-days?sort=first_celebration&order=desc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "national-days"
          ],
          "query": [
            {
              "key": "sort",
              "value": "first_celebration"
            },
            {
              "key": "order",
              "value": "desc"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const years = pm.response.json().map(d => d.first_celebration).filter(y => y !== null);",
              "pm.test('Descending order', () => pm.expect(years).to.eql([...years].sort((a, b) => b - a)));"
            ]
          }
        }
      ]
    },
    {
      "name": "Filter currency EUR",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/national-days?currency_code=EUR&sort=country",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "national-days"
          ],
          "query": [
            {
              "key": "currency_code",
              "value": "EUR"
            },
            {
              "key": "sort",
              "value": "country"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Only EUR', () => data.forEach(d => pm.expect(d.currency_code).to.eql('EUR')));",
              "pm.test('Croatia and Bulgaria included', () => pm.expect(data.map(d => d.country)).to.include.members(['croatia', 'bulgaria']));"
            ]
          }
        }
      ]
    },
    {
      "name": "Japan (BC year)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/national-days/country/japan",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "national-days",
            "country",
            "japan"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d = pm.response.json();",
              "pm.test('Event year is BC (negative)', () => pm.expect(d.event_year).to.eql(-660));",
              "pm.test('Event date ISO 8601', () => pm.expect(d.event_date).to.eql('-0660-02-11'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Former name turkey -> türkiye",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/national-days/country/turkey",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "national-days",
            "country",
            "turkey"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Resolved to new name', () => pm.expect(pm.response.json().country).to.eql('türkiye'));"
            ]
          }
        }
      ]
    },
    {
      "name": "ISO alpha-2 FR",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/national-days/iso/FR",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "national-days",
            "iso",
            "FR"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('France', () => pm.expect(pm.response.json().iso).to.eql('FRA'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown country -> 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/national-days/country/atlantis",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "national-days",
            "country",
            "atlantis"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));",
              "pm.test('Error message', () => pm.expect(pm.response.json()).to.have.property('error'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid sort -> 400",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/national-days?sort=unknown",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "national-days"
          ],
          "query": [
            {
              "key": "sort",
              "value": "unknown"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}